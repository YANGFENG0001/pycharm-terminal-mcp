<idea-plugin>
    <id>dev.terminalmcp.bridge</id>
    <name>终端 MCP 桥接</name>
    <version>0.1.50</version>
    <vendor email="local@example.invalid">Terminal MCP Bridge</vendor>

    <idea-version since-build="262" until-build="262.*"/>

    <description>
        向本地 MCP 客户端提供 PyCharm 终端、终端创建、Deployment 文件传输和远程自动化能力，并提供可配置的全局权限控制。
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends>com.jetbrains.plugins.webDeployment</depends>
    <depends optional="true" config-file="terminal-mcp-mcpserver.xml">com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.terminalmcp.TerminalMcpSettings"/>
        <applicationConfigurable
            id="dev.terminalmcp.settings"
            parentId="tools"
            displayName="终端 MCP 桥接"
            instance="dev.terminalmcp.TerminalMcpConfigurable"/>
        <postStartupActivity implementation="dev.terminalmcp.TerminalMcpStartupActivity"/>
        <notificationGroup id="Terminal MCP Bridge" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action
            id="dev.terminalmcp.CopyMcpConfigAction"
            class="dev.terminalmcp.CopyMcpConfigAction"
            text="复制终端 MCP 桥接配置"
            description="复制终端 MCP 桥接的全局 MCP 配置">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
